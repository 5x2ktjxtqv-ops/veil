#!/bin/sh
set -u

usage() {
    cat <<'EOF'
Usage:
  veil-task-run [options] -- command [args...]

Options:
  --status-file FILE  Task status JSON file. Defaults to
                      $VEIL_TASK_STATUS_FILE or ~/.local/state/veil/task-status.json.
  --tool NAME         Short producer label, such as codex, claude, build.
  --message TEXT      Compact user-owned status text. Do not put prompts or secrets here.
  -h, --help          Show this help.

Example:
  Tools/veil-task-run --tool build --message "swift test" -- swift test
EOF
}

status_file="${VEIL_TASK_STATUS_FILE:-"$HOME/.local/state/veil/task-status.json"}"
tool="${VEIL_TASK_TOOL:-task}"
message="${VEIL_TASK_MESSAGE:-}"

while [ "$#" -gt 0 ]; do
    case "$1" in
        --status-file)
            if [ "$#" -lt 2 ]; then
                echo "veil-task-run: --status-file requires a value" >&2
                exit 64
            fi
            status_file="$2"
            shift 2
            ;;
        --tool)
            if [ "$#" -lt 2 ]; then
                echo "veil-task-run: --tool requires a value" >&2
                exit 64
            fi
            tool="$2"
            shift 2
            ;;
        --message)
            if [ "$#" -lt 2 ]; then
                echo "veil-task-run: --message requires a value" >&2
                exit 64
            fi
            message="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "veil-task-run: unknown option $1" >&2
            usage >&2
            exit 64
            ;;
        *)
            break
            ;;
    esac
done

if [ "$#" -eq 0 ]; then
    echo "veil-task-run: command is required" >&2
    usage >&2
    exit 64
fi

if [ -z "$message" ]; then
    message="task"
fi

json_string() {
    printf '%s' "$1" \
        | tr '\n\r\t' '   ' \
        | sed 's/\\/\\\\/g; s/"/\\"/g'
}

write_status() {
    state="$1"
    detail="$2"
    timestamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    directory="$(dirname "$status_file")"

    if ! mkdir -p "$directory"; then
        echo "veil-task-run: cannot create status directory $directory" >&2
        return 1
    fi

    tmp="$(mktemp "$status_file.XXXXXX")" || {
        echo "veil-task-run: cannot create temporary status file" >&2
        return 1
    }

    printf '{"state":"%s","tool":"%s","message":"%s","updated_at":"%s"}\n' \
        "$(json_string "$state")" \
        "$(json_string "$tool")" \
        "$(json_string "$detail")" \
        "$(json_string "$timestamp")" > "$tmp" || {
            rm -f "$tmp"
            echo "veil-task-run: cannot write task status" >&2
            return 1
        }

    if ! mv "$tmp" "$status_file"; then
        rm -f "$tmp"
        echo "veil-task-run: cannot publish task status" >&2
        return 1
    fi
}

write_status "running" "$message" || true

"$@"
exit_code="$?"

if [ "$exit_code" -eq 0 ]; then
    write_status "succeeded" "${VEIL_TASK_SUCCESS_MESSAGE:-done}" || true
else
    write_status "failed" "exit $exit_code" || true
fi

exit "$exit_code"
